@model IPagedResult
@{
    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => !q.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(q => q.Key, q => (string?)q.Value.ToString());
        query["page"] = page.ToString();
        return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(query);
    }

    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.TotalPages, Model.Page + 2);
    var from = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="text-muted small">@Format.Number(Model.TotalCount) kayıttan @from–@to arası gösteriliyor</span>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Sayfalama">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@PageUrl(Model.Page - 1)" aria-label="Önceki">&laquo;</a>
                </li>
                @for (var i = first; i <= last; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="@PageUrl(i)">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@PageUrl(Model.Page + 1)" aria-label="Sonraki">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
