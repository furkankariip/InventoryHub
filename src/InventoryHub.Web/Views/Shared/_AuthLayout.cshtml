<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · InventoryHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
<main class="auth-card card shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="auth-logo"><i class="bi bi-box-seam-fill"></i></div>
            <h1 class="h4 mb-1">InventoryHub</h1>
            <p class="text-muted small mb-0">Stok ve Sipariş Yönetim Sistemi</p>
        </div>
        @RenderBody()
    </div>
</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
