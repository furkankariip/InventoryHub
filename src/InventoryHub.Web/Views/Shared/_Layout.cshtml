@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · InventoryHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-box-seam-fill"></i> InventoryHub
        </div>
        <nav class="nav flex-column">
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Gösterge Paneli</a>
            <div class="nav-section">Satış</div>
            <a class="nav-link @Active("Orders")" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Siparişler</a>
            <a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Müşteriler</a>
            <div class="nav-section">Envanter</div>
            <a class="nav-link @Active("Products")" asp-controller="Products" asp-action="Index"><i class="bi bi-box"></i> Ürünler</a>
            <a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Kategoriler</a>
            <a class="nav-link @Active("Stock")" asp-controller="Stock" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Stok Hareketleri</a>
            @if (isAdmin)
            {
                <div class="nav-section">Yönetim</div>
                <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> Kullanıcılar</a>
            }
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Menü">
                <i class="bi bi-list"></i>
            </button>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-sm-inline">
                    <i class="bi bi-person-circle"></i> @User.Identity?.Name
                    <span class="badge text-bg-light border">@(isAdmin ? Roles.Admin : Roles.Staff)</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Çıkış</button>
                </form>
            </div>
        </header>

        <main class="content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
