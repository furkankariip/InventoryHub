@using InventoryHub.Application.Stock
@using Microsoft.AspNetCore.Mvc.Rendering
@model ListViewModel<StockMovementQuery, StockMovementListItem>
@{
    ViewData["Title"] = "Stok Hareketleri";
    var q = Model.Query;
}

<div class="page-header">
    <h1>Stok Hareketleri</h1>
    <a asp-action="Adjust" class="btn btn-primary"><i class="bi bi-arrow-down-up"></i> Yeni Stok Hareketi</a>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2">
            <div class="col-md-5">
                <select name="productId" class="form-select" asp-items="ViewBag.Products">
                    <option value="">Tüm ürünler</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select"
                        asp-items="@(new SelectList(Html.GetEnumSelectList<StockMovementType>(), "Value", "Text", ((int?)q.Type)?.ToString()))">
                    <option value="">Tüm hareket türleri</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-secondary flex-fill">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Temizle"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Tarih</th><th>Ürün</th><th>Tür</th><th class="text-end">Miktar</th><th class="text-end">Sonraki Stok</th><th>Açıklama</th><th>Kullanıcı</th></tr></thead>
            <tbody>
            @foreach (var m in Model.Result.Items)
            {
                <tr>
                    <td class="text-nowrap">@Format.Timestamp(m.CreatedAt)</td>
                    <td><a asp-controller="Products" asp-action="Details" asp-route-id="@m.ProductId">@m.ProductName</a> <code class="small">@m.Sku</code></td>
                    <td><span class="badge @m.Type.BadgeClass()">@m.Type.DisplayName()</span></td>
                    <td class="text-end fw-semibold @(m.Quantity < 0 ? "text-danger" : "text-success")">@(m.Quantity > 0 ? "+" : "")@m.Quantity</td>
                    <td class="text-end">@m.StockAfter</td>
                    <td class="small">
                        @if (m.OrderId.HasValue)
                        {
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@m.OrderId">@m.Description</a>
                        }
                        else
                        {
                            @m.Description
                        }
                    </td>
                    <td class="small text-muted">@m.CreatedBy</td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Hareket bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0">
        <partial name="_Pagination" model="Model.Result" />
    </div>
</div>
