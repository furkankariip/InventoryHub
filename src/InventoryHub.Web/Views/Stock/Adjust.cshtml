@using Microsoft.AspNetCore.Mvc.Rendering
@model InventoryHub.Application.Stock.StockAdjustmentModel
@{
    ViewData["Title"] = "Stok Hareketi";
    StockMovementType[] allowed = [StockMovementType.Purchase, StockMovementType.Return, StockMovementType.Adjustment];
    var typeItems = allowed.Select(t => new SelectListItem(t.DisplayName(), t.ToString(), t == Model.Type));
}

<div class="page-header">
    <h1>Stok Hareketi</h1>
</div>

<div class="card" style="max-width: 640px">
    <div class="card-body">
        <form asp-action="Adjust" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="0">Ürün seçin...</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="typeItems" class="form-select" id="typeSelect"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label" id="quantityLabel"></label>
                <input asp-for="Quantity" type="number" min="0" class="form-control" />
                <div class="form-text" id="quantityHelp"></div>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" placeholder="Örn: Tedarikçi faturası #1234" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const typeSelect = document.getElementById('typeSelect');
        const help = document.getElementById('quantityHelp');
        const updateHelp = () => {
            help.textContent = typeSelect.value === 'Adjustment'
                ? 'Sayım sonrası depodaki GERÇEK stok miktarını girin; fark otomatik hesaplanır.'
                : 'Stoğa eklenecek miktarı girin.';
        };
        typeSelect.addEventListener('change', updateHelp);
        updateHelp();
    </script>
}
