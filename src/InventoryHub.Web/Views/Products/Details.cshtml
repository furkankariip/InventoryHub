@model InventoryHub.Application.Products.ProductDetail
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Ürünler</a>
        <h1 class="mt-1">@Model.Name</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Stock" asp-action="Adjust" asp-route-productId="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-arrow-down-up"></i> Stok Hareketi</a>
        @if (User.IsInRole(Roles.Admin))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Düzenle</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted fw-normal">Stok kodu</dt><dd class="col-7"><code>@Model.Sku</code></dd>
                    <dt class="col-5 text-muted fw-normal">Kategori</dt><dd class="col-7">@Model.CategoryName</dd>
                    <dt class="col-5 text-muted fw-normal">Birim fiyat</dt><dd class="col-7">@Format.Money(Model.UnitPrice)</dd>
                    <dt class="col-5 text-muted fw-normal">Durum</dt>
                    <dd class="col-7">@(Model.IsActive ? "Satışta" : "Pasif")</dd>
                    <dt class="col-5 text-muted fw-normal">Eklenme</dt><dd class="col-7">@Format.Date(Model.CreatedAt)</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />
                    <p class="mb-0 text-muted">@Model.Description</p>
                }
            </div>
        </div>
        <div class="row g-3">
            <div class="col-6">
                <div class="card text-center @(Model.IsLowStock ? "border-danger" : "")">
                    <div class="card-body">
                        <div class="text-muted small">Mevcut Stok</div>
                        <div class="fs-3 fw-bold @(Model.IsLowStock ? "text-danger" : "")">@Format.Number(Model.StockQuantity)</div>
                        <div class="small text-muted">Kritik: @Model.ReorderLevel</div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted small">Toplam Satış</div>
                        <div class="fs-3 fw-bold">@Format.Number(Model.TotalSold)</div>
                        <div class="small text-muted">adet</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                Son Stok Hareketleri
                <a asp-controller="Stock" asp-action="Index" asp-route-productId="@Model.Id" class="small fw-normal">Tümü</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Tarih</th><th>Tür</th><th class="text-end">Miktar</th><th class="text-end">Sonraki Stok</th><th>Açıklama</th><th>Kullanıcı</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.RecentMovements)
                    {
                        <tr>
                            <td class="text-nowrap">@Format.Timestamp(m.CreatedAt)</td>
                            <td><span class="badge @m.Type.BadgeClass()">@m.Type.DisplayName()</span></td>
                            <td class="text-end fw-semibold @(m.Quantity < 0 ? "text-danger" : "text-success")">@(m.Quantity > 0 ? "+" : "")@m.Quantity</td>
                            <td class="text-end">@m.StockAfter</td>
                            <td class="small">@m.Description</td>
                            <td class="small text-muted">@m.CreatedBy</td>
                        </tr>
                    }
                    @if (Model.RecentMovements.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Stok hareketi yok.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
