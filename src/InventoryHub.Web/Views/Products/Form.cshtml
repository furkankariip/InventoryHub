@model InventoryHub.Application.Products.ProductFormModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Ürün" : "Ürün Düzenle";
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="card" style="max-width: 820px">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ConcurrencyStamp" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sku" class="form-label"></label>
                    <input asp-for="Sku" class="form-control text-uppercase" />
                    <span asp-validation-for="Sku" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="0">Seçiniz...</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnitPrice" class="form-label"></label>
                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
                @if (isNew)
                {
                    <div class="col-md-6">
                        <label asp-for="InitialStock" class="form-label"></label>
                        <input asp-for="InitialStock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="InitialStock" class="text-danger"></span>
                    </div>
                }
                <div class="col-md-6">
                    <label asp-for="ReorderLevel" class="form-label"></label>
                    <input asp-for="ReorderLevel" class="form-control" type="number" min="0" />
                    <div class="form-text">Stok bu seviyeye düştüğünde ürün kritik olarak işaretlenir.</div>
                    <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            @if (!isNew)
            {
                <div class="form-text mt-3"><i class="bi bi-info-circle"></i> Stok miktarı buradan değil, <a asp-controller="Stock" asp-action="Adjust" asp-route-productId="@Model.Id">stok hareketi</a> ile değiştirilir; böylece her değişiklik kayıt altına alınır.</div>
            }

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@(isNew ? null : Model.Id)" class="btn btn-link">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
